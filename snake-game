# A version of the traditional game 'Snake' 
# Import everything from tkinter for GUI creation
from tkinter import *

import random

# Game configuration constants
GAME_WIDTH = 1190  # Width of the game window
GAME_HEIGHT = 770  # Height of the game window
SPEED = 80  # Speed of the snake (milliseconds between movements)
SPACE_SIZE = 35  # Size of each grid space
BODY_PARTS = 3  # Starting length of the snake
SNAKE_COLOUR = "#264653"
FOOD_COLOUR = "#e9c46a"
BACKGROUND_COLOUR = "#2a9d8f"


class Snake:
    def __init__(self):
        self.body_size = BODY_PARTS
        self.coordinates = []  # List of [x, y] positions of each body segment
        self.squares = []  # List of canvas square objects that make up the snake

        # Initialize snake in top-left corner with multiple body parts
        for i in range(0, BODY_PARTS):
            self.coordinates.append([0, 0])

        # Draw each body segment as a square on the canvas
        for x, y in self.coordinates:
            square = canvas.create_rectangle(x, y, x + SPACE_SIZE, y + SPACE_SIZE, fill=SNAKE_COLOUR, tag="snake")
            self.squares.append(square)


class Food:
    # Generate random coordinates that align with the grid
    def __init__(self):
        x = random.randint(0, (GAME_WIDTH//SPACE_SIZE)-1) * SPACE_SIZE
        y = random.randint(0, (GAME_HEIGHT//SPACE_SIZE)-1) * SPACE_SIZE
        self.coordinates = (x, y)

        # Draw the food as a circle (oval) on the canvas
        canvas.create_oval(x, y, x + SPACE_SIZE, y +SPACE_SIZE, fill=FOOD_COLOUR, tag="food")


# Function to handle each game tick or move
def next_turn(snake, food):

    if paused:
        return

    x, y = snake.coordinates[0]  # Head of the snake

    # Move the head in the current direction
    if direction == "up":
        y -= SPACE_SIZE
    elif direction == "down":
        y += SPACE_SIZE
    elif direction == "left":
        x -= SPACE_SIZE
    elif direction == "right":
        x += SPACE_SIZE

    # Allow for snake to loop from one side of the screen to the other when colliding with a wall
    x %= GAME_WIDTH
    y %= GAME_HEIGHT

    # Insert new head position at the front of the coordinate list
    snake.coordinates.insert(0, [x, y])

    # Draw a new square at the new head position
    square = canvas.create_rectangle(
        x, y, x + SPACE_SIZE, y + SPACE_SIZE, fill=SNAKE_COLOUR)

    snake.squares.insert(0, square)

    # Check if snake has eaten the food
    if (x,y) == tuple(food.coordinates):
        global score
        score += 1
        label.config(text="SCORE: {}".format(score))

        canvas.delete("food")  # Remove the eaten food
        food = Food()  # Create new food

    else:
        # Remove the tail if no food was eaten
        del snake.coordinates[-1]
        canvas.delete(snake.squares[-1])
        del snake.squares[-1]

    # Check for collisions with wall or self
    if check_collisions(snake):
        game_over()

    # Call next_turn again after a delay to keep the game running
    window.after(SPEED, next_turn, snake, food)


def change_direction(new_direction):
    global direction

    # Prevent the snake from reversing direction
    if new_direction == 'left':
        if direction != 'right':
            direction = new_direction

    elif new_direction == 'right':
        if direction != 'left':
            direction = new_direction

    elif new_direction == 'up':
        if direction != 'down':
            direction = new_direction

    elif new_direction == 'down':
        if direction != 'up':
            direction = new_direction


def check_collisions(snake):
    x, y = snake.coordinates[0]  # Snake head position

    # Wall collision
    # if x < 0 or x >= GAME_WIDTH:
    #    return True

    # elif y < 0 or y >= GAME_HEIGHT:
    #    return True

    # Self collision (head touches body)
    for body_part in snake.coordinates[1:]:
        if x == body_part[0] and y == body_part[1]:
            return True

    return False

paused = False
def toggle_pause(event=None):
    global paused
    paused = not paused

    if paused:
        # Only create the pause text if it doesn't already exist
        if not canvas.find_withtag('pauseText'):
            canvas.create_text(canvas.winfo_width()/2, canvas.winfo_height()/2,
                               font=('Helvetica', 70), text="PAUSED", fill="white", tag='pauseText')
    else:
        canvas.delete('pauseText')
        next_turn(snake, food)

def game_over():
    canvas.delete(ALL)
    canvas.create_text(canvas.winfo_width()/2, canvas.winfo_height()/2, font=('Helvetica', 70), text="GAME OVER", fill="#ffffff")


# === GUI SETUP ===
# Create the main window
window = Tk()
window.title("Snake Game")
window.resizable(False, False)

score = 0
direction = 'down'  # Initial direction

# Score label at the top
label = Label(window, text="SCORE: {}".format(score), font=('Helvetica', 40))
label.pack()

# Create the canvas where the game happens
canvas = Canvas(window, bg=BACKGROUND_COLOUR, height=GAME_HEIGHT, width=GAME_WIDTH)
canvas.pack()

window.update()  # Update to get actual window size

# Center the window on the screen
window_width = window.winfo_width()
window_height = window.winfo_height()
screen_width = window.winfo_screenwidth()
screen_height = window.winfo_screenheight()

x = int((screen_width/2) - (window_width/2))
y = int((screen_height/2) - (window_height/2))

window.geometry(f"{window_width}x{window_height}+{x}+{y}")

# Bind arrow keys to change direction
window.bind('<Left>', lambda event: change_direction('left'))
window.bind('<Right>', lambda event: change_direction('right'))
window.bind('<Up>', lambda event: change_direction('up'))
window.bind('<Down>', lambda event: change_direction('down'))
window.bind('<space>', toggle_pause)

# Create the snake and the first food
snake = Snake()
food = Food()

# Start the game
next_turn(snake, food)

# Keep the main window open
window.mainloop()

